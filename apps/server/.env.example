# ---------------------------------------------------------------------------
# Motion Studio — API server
#
# Copy to apps/server/.env and fill in MONGODB_URI. Everything else has a
# working default: uploads go to local disk and the AI generator falls back to a
# built-in offline planner, so the studio runs with no cloud credentials at all.
# ---------------------------------------------------------------------------

NODE_ENV="development"
PORT=5030
APP_VERSION="1.0.0"

# APP URLS — used for CORS and for building absolute media URLs.
CLIENT_WEB_APP_URL="http://localhost:3000"
SERVER_APP_URL="http://localhost:5030"

# DATABASE — the only required value.
MONGODB_URI="mongodb://localhost:27017/motion_studio"

# ---------------------------------------------------------------------------
# Storage — uploads are written to ./uploads and served from /uploads.
# ---------------------------------------------------------------------------
# Signs local upload tickets so /uploads is not a world-writable endpoint.
UPLOAD_SIGNING_SECRET="change-me-in-production"
UPLOAD_URL_TTL_MINUTES=15

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
# Renders run in this process. Each concurrent render costs one Chrome instance,
# so raise this only on a machine with the RAM to match.
RENDER_CONCURRENCY=1
# Hard ceiling on a single render, in milliseconds (default 10 minutes).
RENDER_TIMEOUT_MS=600000
# Point at an existing Chrome/Chromium to skip Remotion's one-time download.
REMOTION_BROWSER_EXECUTABLE=""

# ---------------------------------------------------------------------------
# AI advertisement generation
# ---------------------------------------------------------------------------
# Optional. Without a key the generator uses its offline planner instead.
OPEN_AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
# Optional vector search for the ad planner.
PINE_CONE_API_KEY=""
PINE_CONE_INDEX=""
