{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "target": "es2016",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/schema/*": ["../../packages/schema/src/*"],
      "@workspace/motion": ["../../packages/motion/src/index.ts"],
      "@workspace/motion/*": ["../../packages/motion/src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "../../packages/ui",
    "../../packages/data-layer",
    "../../packages/**"
  ]
}
