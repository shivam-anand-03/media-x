<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EssentoLabs - Reset Your Password</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap");

      * {
        box-sizing: border-box;
      }

      body {
        font-family: "DM Sans", Arial, sans-serif;
        line-height: 1.6;
        color: #2d1f3d;
        margin: 0;
        padding: 0;
        background-color: #f3eefa;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(64, 0, 96, 0.1);
      }

      /* ── Header ── */
      .header {
        background: #400060;
        padding: 32px 24px 28px;
        text-align: center;
      }

      .logo-mark {
        display: inline-block;
        width: 44px;
        height: 44px;
        background: #9009d3;
        border-radius: 12px;
        line-height: 44px;
        font-size: 22px;
        margin-bottom: 10px;
      }

      .header h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.5px;
      }

      .header p {
        margin: 6px 0 0;
        font-size: 13px;
        color: #bc7dd8;
        letter-spacing: 0.3px;
      }

      /* ── Content ── */
      .content {
        padding: 32px 28px 24px;
      }

      .icon {
        text-align: center;
        font-size: 48px;
        margin-bottom: 16px;
      }

      .content h2 {
        margin: 0 0 10px;
        font-size: 18px;
        font-weight: 600;
        color: #400060;
      }

      .content p {
        margin: 0 0 20px;
        font-size: 15px;
        color: #4a3360;
      }

      /* ── CTA Box ── */
      .cta-container {
        background: #f3eefa;
        border: 1.5px solid #dcd4fd;
        border-radius: 12px;
        padding: 28px 20px;
        text-align: center;
        margin: 24px 0;
      }

      .cta-container h3 {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 600;
        color: #400060;
      }

      .cta-container p {
        margin: 0 0 18px;
        font-size: 14px;
        color: #7936a2;
      }

      .btn {
        display: inline-block;
        background: #800080;
        color: #ffffff !important;
        padding: 13px 36px;
        text-decoration: none;
        border-radius: 50px;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.3px;
      }

      /* ── Warning ── */
      .warning {
        background: #fff8ff;
        border-left: 3px solid #9009d3;
        border-radius: 0 8px 8px 0;
        padding: 14px 16px;
        font-size: 13px;
        color: #4a3360;
        margin: 0 0 20px;
      }

      .warning strong {
        color: #400060;
      }

      /* ── Divider ── */
      .divider {
        border: none;
        border-top: 1px solid #ede8f5;
        margin: 24px 0;
      }

      /* ── Footer ── */
      .footer {
        background: #f3eefa;
        padding: 20px 28px;
        text-align: center;
        border-top: 1px solid #ede8f5;
      }

      .footer p {
        margin: 4px 0;
        font-size: 12px;
        color: #8b62a8;
      }

      .footer .brand {
        font-weight: 700;
        color: #7936a2;
        font-size: 13px;
      }

      /* ── Responsive ── */
      @media (max-width: 600px) {
        .container {
          margin: 12px;
          border-radius: 12px;
        }
        .content {
          padding: 24px 18px 18px;
        }
        .footer {
          padding: 16px 18px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <div class="logo-mark">⚡</div>
        <h1>EssentoLabs</h1>
        <p>Freelancer &amp; Client Workspace</p>
      </div>

      <!-- Body -->
      <div class="content">
        <div class="icon">🔑</div>

        <h2>Hello <%= userName %>,</h2>

        <p>
          We received a request to reset your password for your
          <strong>EssentoLabs</strong> account. Don't worry — it happens to the best
          of us 🙂
        </p>

        <div class="cta-container">
          <h3>Reset Your Password</h3>
          <p>Click the button below to create a new password.</p>
          <a href="<%= resetPasswordLink %>" class="btn">Reset Password</a>
        </div>

        <div class="warning">
          ⏳ <strong>Important:</strong> This link is valid for the next
          <strong>15 minutes</strong>. If it expires, you'll need to request a
          new password reset.
        </div>

        <hr class="divider" />

        <p style="margin: 0; font-size: 14px">
          If you did not request this password reset, you can safely ignore this
          email. Your account will remain secure.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p class="brand">EssentoLabs</p>
        <p>Need help? Contact our support team anytime.</p>
        <p>© EssentoLabs — All rights reserved</p>
      </div>
    </div>
  </body>
</html>
