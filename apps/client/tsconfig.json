{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/schema/*": ["../../packages/schema/src/*"],
      "@workspace/data-access": ["../../packages/data-access/src/index.ts"],
      "@workspace/data-access/*": ["../../packages/data-access/src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "modules/workflow/constants/node-types.ts"
  ],
  "exclude": ["node_modules"]
}
