# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node Dependencies
node_modules
.pnp
.pnp.js

# Testing
coverage

# Turbo Repo Cache
.turbo

# IDE / Editor Files
.vscode
.DS_Store

# Vercel
.vercel

# Build Outputs
.next/
out/
build/
dist/
.dist/
apps/**/dist/
apps/**/.dist/
packages/**/dist/
packages/**/.dist/

# Compiled TypeScript files in source directories
src/**/*.d.ts
src/**/*.d.ts.map
src/**/*.js
!src/**/*.config.js
packages/**/*.d.ts
packages/**/*.d.ts.map
packages/**/*.js
!packages/**/*.config.js
apps/**/*.d.ts
apps/**/*.d.ts.map
apps/server/src/**/*.js
# Environment Files
.env
.env.*
# Keep example envs. NOTE: gitignore has no trailing-comment syntax — a comment
# on this line would make the whole string a literal pattern and silently break
# the negation, which is exactly what used to happen here.
!.env.example
!**/.env.example

# Generated Files
/generated/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
*.pem
nginx.conf
/.vscode
/.claude
/postman

# Credentials — never commit these. Belt and braces: the per-app .gitignore
# covers apps/server/keys/, and these catch anything placed elsewhere.
keys/
*key.json
*credentials*.json
