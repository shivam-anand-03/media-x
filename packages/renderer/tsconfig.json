{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@workspace/motion": ["../motion/src/index.ts"],
      "@workspace/motion/*": ["../motion/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
